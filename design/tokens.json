{
  "meta": {
    "name": "Remotier",
    "version": "1.0",
    "mode": "dark-only"
  },
  "color": {
    "surface": {
      "void": "#000000",
      "shell": "#050605",
      "raised": "#0F110F",
      "rule": "#1F221F",
      "ruleLow": "#101210",
      "control": "#2A2E2A"
    },
    "text": {
      "bone": "#E8EBE6",
      "secondary": "#A8ADA8",
      "dim": "#7E827E",
      "faint": "#6B6F6B",
      "onAccent": "#000000"
    },
    "accent": {
      "lime": "#D9FF00",
      "limeHover": "#E9FF6B"
    },
    "status": {
      "connected": "#D9FF00",
      "warning": "#E8A33D",
      "error": "#E5484D",
      "idle": "#6B6F6B"
    }
  },
  "font": {
    "display": {
      "family": "'Martian Mono', monospace",
      "weights": [
        600,
        700
      ],
      "tracking": "-0.02em to -0.035em",
      "minSize": 12,
      "note": "headings, wordmark, taglines only — never paragraphs"
    },
    "ui": {
      "family": "'JetBrains Mono', monospace",
      "weights": [
        300,
        400,
        500
      ],
      "note": "interface, body, labels, code"
    }
  },
  "typeScale": {
    "display": {
      "size": 64,
      "lineHeight": 0.98,
      "font": "display"
    },
    "headline": {
      "size": 30,
      "lineHeight": 1.2,
      "font": "display"
    },
    "title": {
      "size": 19,
      "lineHeight": 1.3,
      "font": "display"
    },
    "body": {
      "size": 14,
      "lineHeight": 1.6,
      "font": "ui"
    },
    "small": {
      "size": 12,
      "lineHeight": 1.7,
      "font": "ui"
    },
    "label": {
      "size": 10,
      "lineHeight": 1.4,
      "font": "ui",
      "transform": "uppercase",
      "tracking": "0.16em"
    }
  },
  "radius": {
    "row": 0,
    "control": 5,
    "panel": 10,
    "appIcon": 29
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "motion": {
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "state": 120,
    "panel": 240,
    "rule": "no spring, no bounce; connection state changes are instant"
  },
  "rules": [
    "Dark only. There is no light theme.",
    "Separate with 1px rules, never shadows or elevation.",
    "One lime element per view, two at most. Lime is never a large fill or a gradient.",
    "Every action has a keyboard shortcut; the mouse is optional.",
    "Data rows: 36px tall, radius 0, no zebra striping.",
    "Icons: 1.5px stroke, 20px grid, square terminals, no fills.",
    "The lime block cursor replaces every spinner."
  ]
}
