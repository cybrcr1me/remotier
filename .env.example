# Copy to `.env` and fill in. Read by `bun run build:mac` (scripts/build-mac.sh).
# `.env` is gitignored and the script refuses to run if it ever stops being.
#
# Nothing here reaches the app: Vite only exposes variables prefixed `VITE_` to the
# frontend bundle, and the Rust side never reads these at runtime.

# The Developer ID Application certificate in your login keychain.
# `bun run build:mac --list-identities` lists what this machine has.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarisation. Without these the build is signed but not notarised, and macOS still
# shows "cannot be opened because the developer cannot be verified" on another machine.
APPLE_ID="you@example.com"
# An app-specific password from appleid.apple.com - NOT the Apple ID password.
APPLE_PASSWORD="abcd-efgh-ijkl-mnop"
APPLE_TEAM_ID="TEAMID"
