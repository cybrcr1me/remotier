<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Remotier reads ~/.ssh (known_hosts, config, key files) and talks to the ssh-agent
    socket. Under the hardened runtime a signed build needs these or those reads fail at
    runtime, which would look like a bug rather than a permissions problem.
  -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
